        "jsCode": "// =============================================\n// UNIR DATOS DE AMBOS NODOS - FORMATO ESPECÍFICO\n// =============================================\n\n// 1. Obtener datos de Preparar_Input_AI (primer elemento del merge)\nconst datosPrepararInput = $input.all()[0]?.json || {};\n\n// 2. Obtener datos de Consultar_estado_Odoo (segundo elemento del merge)\n// La respuesta de Odoo viene como array: [{...}]\nlet datosOdoo = $input.all()[1]?.json;\nif (Array.isArray(datosOdoo) && datosOdoo.length > 0) {\n    datosOdoo = datosOdoo[0];\n} else {\n    datosOdoo = datosOdoo || {};\n}\n\nconsole.log(\"📥 DATOS DE ODOO (crudo):\", JSON.stringify($input.all()[1]?.json, null, 2));\nconsole.log(\"📥 DATOS DE ODOO (procesado):\", JSON.stringify(datosOdoo, null, 2));\n\n// 3. Extraer el estado_anterior - AHORA SE LLAMA \"estado\" en lugar de \"debug_estado_nuevo\"\nconst estado_anterior = datosOdoo.estado || null;\nconst modoOdoo = estado_anterior?.modo || datosOdoo.modo || null;\nconst pasoOdoo = estado_anterior?.paso || datosOdoo.paso || null;\nconst tipo_dato = estado_anterior?.tipo_dato || datosOdoo.tipo_dato || null\nconst es_requerido = estado_anterior?.es_requerido || datosOdoo.es_requerido || null\nconst mensaje_prompt = estado_anterior?.mensaje_prompt || datosOdoo.mensaje_prompt || null\nconst nombre_mostrar = estado_anterior?.nombre_mostrar || datosOdoo.nombre_mostrar || null\n\n\n\n// 4. Crear el resultado en el formato EXACTO solicitado\nconst resultadoFinal = {\n    // Campos de Preparar_Input_AI\n    text: datosPrepararInput.text || \"0\",\n    session_id: datosPrepararInput.session_id || \"\",\n    image_url: datosPrepararInput.image_url || \"\",\n    platform: datosPrepararInput.platform || \"whatsapp\",\n    account_id: datosPrepararInput.account_id || \"\",\n    conversation_id: datosPrepararInput.conversation_id || \"\",\n    \n    // Campos de Odoo (estado_anterior completo)\n    estado_anterior: estado_anterior,\n    \n    // Campos adicionales de Odoo (modo y paso al nivel raíz también)\n    modo: modoOdoo,\n    paso: pasoOdoo,\n\n    tipo_dato: tipo_dato,\n    es_requerido: es_requerido,\n    mensaje_prompt: mensaje_prompt,\n    nombre_mostrar: nombre_mostrar,\n    // Datos paciente para fácil acceso\n    datos_paciente: estado_anterior?.datos_paciente || {},\n    texto_para_usuario: textoRespuesta\n};\n\n// SPEC 19: normalizar texto de Odoo. MENU_PRINCIPAL sin sesión activa\n// → texto vacío: el saludo conversacional lo sirve el workflow principal.\nlet textoRespuesta = datosOdoo.texto_para_usuario || '';\nif (modoOdoo === 'MENU_PRINCIPAL') {\n    textoRespuesta = '';\n}\n\n// 5. Si estado_anterior es null, crear estructura básica\nif (!estado_anterior) {\n    resultadoFinal.estado_anterior = {\n        modo: datosOdoo.modo || null,\n        paso: datosOdoo.paso || null,\n        datos_paciente: {},\n        timestamp: null\n    };\n}\n\nconsole.log(\"✅ RESULTADO FINAL:\");\nconsole.log(JSON.stringify(resultadoFinal, null, 2));\n\nreturn [{ json: resultadoFinal }];"
      },
